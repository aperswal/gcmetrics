{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "lint:ascii": "bash scripts/check-ascii.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "knip": "knip",
    "jscpd": "jscpd .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm lint && pnpm lint:ascii && pnpm typecheck && pnpm test:coverage && pnpm knip && pnpm jscpd && pnpm test:mutation && pnpm build && pnpm format:check",
    "prepare": "cd .. && husky web/.husky"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "drawably": "0.3.10",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-sonarjs": "^4.2.0",
    "husky": "^9.1.7",
    "jscpd": "^5.1.1",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.27.0"
}
